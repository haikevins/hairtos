{
    "configurations": [
        {
            "name": "HairRTOS STM32F103",
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "intelliSenseMode": "gcc-arm",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "defines": [
                "HR_CFG_ENABLE_SOFTWARE_TIMER=1",
                "HR_CFG_TIMER_TASK_PRIORITY=1"
            ],
            "includePath": [
                "${workspaceFolder}/config",
                "${workspaceFolder}/soc/stm32f1/include",
                "${workspaceFolder}/boards/bluepill_f103c8/include",
                "${workspaceFolder}/drivers/gpio/include",
                "${workspaceFolder}/drivers/uart/include",
                "${workspaceFolder}/drivers/timer/include",
                "${workspaceFolder}/kernel/include",
                "${workspaceFolder}/kernel/internal",
                "${workspaceFolder}/arch/arm/cortex-m3/include",
                "${workspaceFolder}/hairevent/include",
                "${workspaceFolder}/hairevent/internal"
            ]
        }
    ],
    "version": 4
}